---
import { getImage } from 'astro:assets';
import photo from '../assets/photo.jpg';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const ogImage = await getImage({ src: photo, width: 600, format: 'jpg' });
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Me' },
  { href: '/timeline', label: 'Journey' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400..600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="page">
      <nav aria-label="Main">
        {links.map((l) => <a href={l.href} aria-current={l.href === path ? 'page' : undefined}>{l.label}</a>)}
      </nav>
      <main>
        <slot />
      </main>
    </div>

    <style is:global>
      *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

      :root {
        --bg: #edf0ee;
        --ink: #15231f;
        --muted: #55645f;
        --rule: #cdd5d1;
        --accent: #0a7355;
        --display: 'Bricolage Grotesque', system-ui, sans-serif;
        --text: 'Source Serif 4', Georgia, serif;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0e1513;
          --ink: #e4eae7;
          --muted: #94a39d;
          --rule: #26322e;
          --accent: #62d1aa;
        }
      }

      /* overflow-y: scroll keeps the nav from shifting between short and long pages */
      html { overflow-y: scroll; -webkit-text-size-adjust: 100%; }

      body {
        background: var(--bg);
        color: var(--ink);
        font-family: var(--text);
        font-size: 1.125rem;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 64rem;
        margin: 0 auto;
        padding: 0 1.5rem 6rem;
      }

      a {
        color: var(--accent);
        text-decoration-thickness: 1px;
        text-underline-offset: 0.2em;
      }

      a:hover { text-decoration-thickness: 2px; }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 3px;
        border-radius: 2px;
      }

      ::selection { background: var(--accent); color: var(--bg); }

      nav {
        display: flex;
        gap: 1.75rem;
        padding-top: 2.5rem;
        font-family: var(--display);
        font-size: 1rem;
        font-weight: 500;
      }

      nav a {
        color: var(--muted);
        text-decoration: none;
        padding: 0.25rem 0;
        border-bottom: 2px solid transparent;
      }

      nav a:hover { color: var(--ink); }

      nav a[aria-current] {
        color: var(--ink);
        border-bottom-color: var(--accent);
      }

      h1 {
        padding-top: clamp(3.5rem, 9vw, 6rem);
        font-family: var(--display);
        font-size: clamp(3.25rem, 11vw, 7rem);
        font-weight: 700;
        line-height: 0.92;
        letter-spacing: -0.045em;
      }
    </style>
  </body>
</html>
