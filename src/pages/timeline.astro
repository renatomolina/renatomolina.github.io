      </section>

      <footer></footer>
    </div>

    <style is:global>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      :root {
        --bg: #07070a;
        --surface: #0d0d12;
        --surface-2: #12121a;
        --border: #1a1a24;
        --border-hover: #2a2a3a;
        --text: #f0f0f2;
        --text-secondary: #a0a0a8;
        --text-muted: #6a6a72;
        --accent: #6366f1;
        --accent-light: #818cf8;
        --accent-glow: rgba(99, 102, 241, 0.08);
        --green: #10b981;
        --gold: #f59e0b;
        --purple: #a855f7;
      }

      html { scroll-behavior: smooth; }

      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.7;
        min-height: 100vh;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
      }

      .noise {
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0.025;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        z-index: 9999;
      }

      .bg-glow {
        position: fixed;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(120px);
        z-index: 0;
      }

      .bg-glow-1 {
        width: 800px;
        height: 800px;
        top: -200px;
        right: -300px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.06) 0%, transparent 70%);
      }

      .bg-glow-2 {
        width: 600px;
        height: 600px;
        bottom: 20%;
        left: -200px;
        background: radial-gradient(circle, rgba(168, 85, 247, 0.04) 0%, transparent 70%);
      }

      .container {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 24px;
        position: relative;
        z-index: 1;
      }

      nav {
        padding: 40px 0 0;
        display: flex;
        gap: 24px;
      }

      nav a {
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.01em;
        color: var(--text-muted);
        text-decoration: none;
        padding: 8px 0;
        border-bottom: 1px solid transparent;
        transition: all 0.2s;
      }

      nav a:hover { color: var(--text); }

      nav a.nav-active {
        color: var(--text);
        border-bottom-color: var(--accent);
      }

      header {
        padding: 80px 0 0;
      }

      h1 {
        font-size: clamp(2.2rem, 5vw, 3rem);
        font-weight: 700;
        letter-spacing: -0.04em;
        line-height: 1.1;
        background: linear-gradient(135deg, var(--text) 0%, var(--text-secondary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .subtitle {
        color: var(--text-muted);
        font-size: 1.05rem;
        margin-top: 12px;
        font-weight: 300;
      }

      /* Timeline track */
      .timeline {
        position: relative;
        padding: 80px 0 40px 52px;
      }

      .tl-track {
        position: absolute;
        left: 11px;
        top: 80px;
        bottom: 40px;
        width: 2px;
        background: var(--border);
        border-radius: 2px;
        overflow: hidden;
      }

      .tl-track-progress {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 0%;
        background: linear-gradient(to bottom, var(--accent), var(--purple));
        border-radius: 2px;
        transition: height 0.1s linear;
      }

      /* Entry */
      .tl-entry {
        position: relative;
        margin-bottom: 56px;
        opacity: 0;
        transform: translateY(60px) scale(0.97);
        transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
                    transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform, opacity;
      }

      .tl-entry:last-child { margin-bottom: 0; }

      .tl-entry.in-view {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      /* Beacon */
      .tl-beacon {
        position: absolute;
        left: -52px;
        top: 24px;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg);
        border-radius: 50%;
        border: 2px solid var(--border);
        color: var(--accent);
        transition: all 0.4s;
        z-index: 2;
      }

      .tl-beacon svg {
        width: 14px;
        height: 14px;
      }

      .tl-entry.in-view .tl-beacon {
        border-color: var(--accent);
        box-shadow: 0 0 16px var(--accent-glow);
      }

      .beacon-green { color: var(--green); }
      .tl-entry.in-view .beacon-green {
        border-color: var(--green);
        box-shadow: 0 0 16px rgba(16, 185, 129, 0.15);
      }

      .beacon-gold { color: var(--gold); }
      .tl-entry.in-view .beacon-gold {
        border-color: var(--gold);
        box-shadow: 0 0 16px rgba(245, 158, 11, 0.15);
      }

      .beacon-purple { color: var(--purple); }
      .tl-entry.in-view .beacon-purple {
        border-color: var(--purple);
        box-shadow: 0 0 16px rgba(168, 85, 247, 0.15);
      }

      /* Time label */
      time {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        font-weight: 500;
        color: var(--text-muted);
        letter-spacing: 0.06em;
        display: block;
        margin-bottom: 12px;
        text-transform: uppercase;
      }

      /* Card */
      .tl-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 28px 28px 24px;
        position: relative;
        overflow: hidden;
        transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .tl-card::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.04), transparent);
      }

      .tl-card:hover {
        border-color: var(--border-hover);
        background: var(--surface-2);
        transform: translateY(-2px);
        box-shadow: 0 12px 40px -12px rgba(0, 0, 0, 0.5),
                    0 0 0 1px var(--border-hover);
      }

      .card-award {
        border-color: rgba(245, 158, 11, 0.2);
        background: linear-gradient(160deg, rgba(245, 158, 11, 0.03) 0%, var(--surface) 40%);
      }

      .card-award:hover {
        border-color: rgba(245, 158, 11, 0.35);
      }

      .tl-card h2 {
        font-size: 1.15rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: 4px;
      }

      .tl-org {
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 14px;
      }

      .tl-card p:last-of-type {
        font-size: 0.9rem;
        color: var(--text-secondary);
        line-height: 1.7;
      }

      .tl-link {
        display: inline-block;
        margin-top: 14px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        color: var(--accent-light);
        text-decoration: none;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s;
      }

      .tl-link:hover { border-bottom-color: var(--accent-light); }

      /* Badges */
      .tl-badge {
        display: inline-block;
        margin-bottom: 14px;
        padding: 4px 10px;
        font-family: 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        border-radius: 6px;
      }

      .tl-badge.role {
        background: rgba(99, 102, 241, 0.08);
        color: var(--accent-light);
        border: 1px solid rgba(99, 102, 241, 0.15);
      }

      .tl-badge.project {
        background: rgba(16, 185, 129, 0.08);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.15);
      }

      .tl-badge.award {
        background: rgba(245, 158, 11, 0.08);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.15);
      }

      .tl-badge.education {
        background: rgba(168, 85, 247, 0.08);
        color: #c084fc;
        border: 1px solid rgba(168, 85, 247, 0.15);
      }

      footer {
        padding: 80px 0 40px;
        text-align: center;
        color: var(--text-muted);
        font-size: 13px;
        font-family: 'JetBrains Mono', monospace;
      }

      @media (max-width: 600px) {
        .timeline { padding-left: 40px; }
        .tl-beacon { left: -40px; }
        .tl-card { padding: 22px 20px 20px; border-radius: 12px; }
        header { padding: 60px 0 0; }
      }
    </style>

    <script>
      const entries = document.querySelectorAll('.tl-entry');
      const track = document.getElementById('track-progress');
      const timeline = document.querySelector('.timeline');

      // Intersection observer for reveal
      const observer = new IntersectionObserver((items) => {
        items.forEach((item, i) => {
          if (item.isIntersecting) {
            setTimeout(() => item.target.classList.add('in-view'), i * 60);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -80px 0px' });

      entries.forEach((el) => observer.observe(el));

      // Scroll-driven track progress + parallax
      let raf;
      function onScroll() {
        // Track progress
        const rect = timeline.getBoundingClientRect();
        const total = timeline.offsetHeight;
        const scrolled = Math.min(Math.max(-rect.top / (total - window.innerHeight), 0), 1);
        track.style.height = `${scrolled * 100}%`;

        // Parallax
        entries.forEach((entry) => {
          if (!entry.classList.contains('in-view')) return;
          const speed = parseFloat(entry.dataset.speed || '1.03');
          const entryRect = entry.getBoundingClientRect();
          const center = entryRect.top + entryRect.height / 2 - window.innerHeight / 2;
          const offset = center * (speed - 1) * -1;
          entry.style.transform = `translateY(${offset}px) scale(1)`;
        });
      }

      window.addEventListener('scroll', () => {
        if (raf) return;
        raf = requestAnimationFrame(() => { onScroll(); raf = null; });
      }, { passive: true });
    </script>
  </body>
</html>
