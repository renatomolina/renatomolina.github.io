---
import Base from '../layouts/Base.astro';

const kinds = { role: 'Role', project: 'Project', award: 'Award', education: 'Education' };

type Entry = {
  kind: keyof typeof kinds;
  time: string;
  title: string;
  org: string;
  text: string;
  url?: string;
  linkLabel?: string;
};

const entries: Entry[] = [
  {
    kind: 'role', time: '2025 – Present', title: 'Chief Technology Officer', org: 'Skillsetter, Vancouver, BC',
    text: "Set the technical vision and lead the engineering team day to day as its team lead. Work with product to define the technical side and help shape what we build. Own SOC 2 and GDPR compliance, drive AI strategy, and support every other department on anything technical.",
    url: 'https://skillsetter.com', linkLabel: 'skillsetter.com',
  },
  {
    kind: 'role', time: '2024 – 2025', title: 'Principal Software Engineer & Team Lead', org: 'Skillsetter, Vancouver, BC',
    text: "Led technical strategy and development of the core Ruby on Rails application and its APIs. Built AI features on OpenAI, AWS Bedrock, Google Gemini and ElevenLabs, real-time video with WebRTC, and LMS integrations with Blackboard and Canvas. Ran the AWS infrastructure.",
    url: 'https://skillsetter.com', linkLabel: 'skillsetter.com',
  },
  {
    kind: 'role', time: '2016 – 2024', title: 'Senior Software Engineer', org: 'Skillsetter, Vancouver, BC',
    text: "Built the platform from the ground up: full-stack Ruby on Rails, an AWS architecture that scaled, and engineering practices that grew with the company.",
    url: 'https://skillsetter.com', linkLabel: 'skillsetter.com',
  },
  {
    kind: 'role', time: '2016 – 2018', title: 'Senior Software Engineer', org: 'Noomii, Vancouver, BC',
    text: "Built and maintained a coaching marketplace in Ruby on Rails on AWS. Integrated Intercom and Stripe, upgraded the platform from Ruby 1.9 to 2.4, and documented legacy systems by reverse engineering them.",
    url: 'https://www.noomii.com', linkLabel: 'noomii.com',
  },
  {
    kind: 'role', time: '2014 – 2015', title: 'Tech Lead Software Engineer', org: 'Inspira Tecnologia, São Paulo, Brazil',
    text: "Led Android and Ruby teams across web and mobile projects as tech lead and Scrum Master. Designed APIs and mobile apps, and advised startups on technical and business strategy.",
    url: 'https://www.inspira.com.br/', linkLabel: 'inspira.com.br',
  },
  {
    kind: 'role', time: '2013 – 2014', title: 'Chief Technology Officer', org: 'Jazz, São Paulo, Brazil',
    text: "Led projects with a multidisciplinary team and designed the company's innovation process, from UX research to architecture and technology choices. Mentored developers in the Android Jam Program and created the career plan for technology, design and management.",
  },
  {
    kind: 'role', time: '2013', title: 'Chief Technology Officer & Co-founder', org: 'Doog™, Brazil',
    text: "Co-founded a B2B startup for geolocation tracking of sales teams and products. Led technology, product design and the development team, building Android apps and a Ruby on Rails backend. Handled investor relations and sat on the board.",
  },
  {
    kind: 'role', time: '2012 – 2013', title: 'Software Engineer Consultant', org: 'Brasil RFID / Inovacode Solutions, São Paulo, Brazil',
    text: "Built an RFID system with an Android app and a Ruby on Rails backend. Ran feasibility studies, migrated a legacy system to a new architecture, and designed the integration API.",
    url: 'https://www.inovacode.com.br/', linkLabel: 'inovacode.com.br',
  },
  {
    kind: 'award', time: '2012', title: 'Interaction South America', org: 'IxDA / Agência Click',
    text: "Second place in Best Mobile Applications, Innovation and Usability category. Recognized across Latin America.",
    url: 'https://ixda.org/initiatives/interaction-latin-america/', linkLabel: 'ixda.org',
  },
  {
    kind: 'project', time: '2011', title: 'Inverse Maxi', org: 'CESAR, shipped product',
    text: "One of the first smart fridges in Brazil. Customized Android OS and built the layer that lets the built-in tablet control the fridge, from prototype through mass production.",
    url: 'https://www.youtube.com/watch?v=G34Dra2v85c', linkLabel: 'Watch the demo',
  },
  {
    kind: 'project', time: '2011', title: 'Positivo Ypy', org: 'CESAR, shipped product',
    text: "Customized Android OS and built apps for one of Brazil's first consumer tablets, used by hundreds of thousands of people.",
    url: 'https://www.positivotecnologia.com.br', linkLabel: 'positivotecnologia.com.br',
  },
  {
    kind: 'role', time: '2011 – 2013', title: 'Systems Engineer', org: 'CESAR, Sorocaba, Brazil',
    text: "Built mobile, embedded, web and interactive TV systems. Shaped backlogs with product owners, ran UX research (focus groups, interviews, prototyping), and led Android OS customizations for specific products.",
    url: 'https://www.cesar.org.br', linkLabel: 'cesar.org.br',
  },
  {
    kind: 'education', time: '2011 – 2012', title: 'M.Sc. Computer Science (incomplete)', org: 'Universidade Federal de São Carlos (UFSCar)',
    text: "Research on compilers and programming languages, focused on macro systems in Cyan for generating domain-specific languages.",
    url: 'https://cyan-lang.org/', linkLabel: 'cyan-lang.org',
  },
  {
    kind: 'education', time: '2008 – 2011', title: 'B.Sc. Computer Science', org: 'Universidade Federal de São Carlos (UFSCar)',
    text: "Research on compilers and OLAP systems. Co-founded and organized SeCoT, a tech conference that brought international speakers to campus for three editions.",
    url: 'https://www.ufscar.br', linkLabel: 'ufscar.br',
  },
  {
    kind: 'education', time: '2006', title: 'Tech Instructor', org: 'Microlins Franchising',
    text: "Taught computer architecture, programming (PHP, JavaScript) and frontend development (HTML, CSS).",
  },
];
---

<Base title="Journey — Renato Molina Toth" description="Career timeline and projects.">
  <header>
    <h1>Journey</h1>
    <p class="lede">Roles, shipped products and studies, newest first.</p>
  </header>

  <ol>
    {entries.map((e) => (
      <li>
        <div class="when">
          <time>{e.time}</time>
          <span>{kinds[e.kind]}</span>
        </div>
        <div class="what">
          <h2>{e.title}</h2>
          <p class="org">{e.org}</p>
          <p class="desc">{e.text}</p>
          {e.url && <a href={e.url} target="_blank" rel="noopener">{e.linkLabel}</a>}
        </div>
      </li>
    ))}
  </ol>
</Base>

<style>
  .lede {
    margin-top: 1.5rem;
    font-family: var(--display);
    font-size: clamp(1.15rem, 2.4vw, 1.45rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  ol {
    list-style: none;
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }

  li {
    display: grid;
    grid-template-columns: 13rem minmax(0, 62ch);
    gap: 0 3rem;
    padding: 2.25rem 0;
    border-top: 1px solid var(--rule);
  }

  .when {
    font-family: var(--display);
    line-height: 1.3;
  }

  time {
    display: block;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    font-variant-numeric: tabular-nums;
  }

  .when span {
    font-size: 0.95rem;
    color: var(--muted);
  }

  h2 {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .org {
    margin-top: 0.25rem;
    font-family: var(--display);
    font-size: 1rem;
    color: var(--muted);
  }

  .desc {
    margin-top: 0.9rem;
    font-size: 1.0625rem;
  }

  .what a {
    display: inline-block;
    margin-top: 0.75rem;
    font-family: var(--display);
    font-size: 0.95rem;
  }

  @media (max-width: 52rem) {
    li {
      grid-template-columns: minmax(0, 1fr);
      padding: 1.75rem 0;
    }

    .when {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      margin-bottom: 0.6rem;
    }

    time { font-size: 1.1rem; }
  }
</style>
